<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fleet_maintenance_plan_tree" model="ir.ui.view">
        <field name="name">fleet.maintenance.plan.tree</field>
        <field name="model">fleet.maintenance.plan</field>
        <field name="arch" type="xml">
            <tree decoration-danger="due_state == 'overdue'" decoration-warning="due_state == 'due_soon'">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="service_type_id" optional="hide"/>
                <field name="current_odometer"/>
                <field name="next_due_odometer"/>
                <field name="next_due_date"/>
                <field name="due_state" widget="badge"
                       decoration-danger="due_state == 'overdue'"
                       decoration-warning="due_state == 'due_soon'"
                       decoration-success="due_state == 'ok'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_fleet_maintenance_plan_form" model="ir.ui.view">
        <field name="name">fleet.maintenance.plan.form</field>
        <field name="model">fleet.maintenance.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_service" type="object" string="Create Service Now"
                            class="btn-primary"/>
                    <field name="due_state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_services" type="object" class="oe_stat_button"
                                icon="fa-wrench">
                            <field name="service_count" widget="statinfo" string="Services"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Oil change"/></h1>
                    </div>
                    <group>
                        <group string="What">
                            <field name="vehicle_id"/>
                            <field name="service_type_id"/>
                            <field name="vendor_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="When">
                            <field name="interval_km"/>
                            <field name="interval_months"/>
                            <field name="start_date"/>
                        </group>
                        <group string="Last Service">
                            <field name="last_service_date"/>
                            <field name="last_service_odometer"/>
                        </group>
                        <group string="Next Service">
                            <field name="current_odometer"/>
                            <field name="next_due_odometer" invisible="not interval_km"/>
                            <field name="next_due_date" invisible="not interval_months"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Parts" name="parts">
                            <field name="part_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_fleet_maintenance_plan_search" model="ir.ui.view">
        <field name="name">fleet.maintenance.plan.search</field>
        <field name="model">fleet.maintenance.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="vehicle_id"/>
                <filter name="overdue" string="Overdue" domain="[('due_state', '=', 'overdue')]"/>
                <filter name="due_soon" string="Due Soon" domain="[('due_state', '=', 'due_soon')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter name="group_service_type" string="Service Type"
                            context="{'group_by': 'service_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_fleet_maintenance_plan_pivot" model="ir.ui.view">
        <field name="name">fleet.maintenance.plan.pivot</field>
        <field name="model">fleet.maintenance.plan</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="vehicle_id" type="row"/>
                <field name="service_type_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_fleet_maintenance_plan" model="ir.actions.act_window">
        <field name="name">Maintenance Plans</field>
        <field name="res_model">fleet.maintenance.plan</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a preventive maintenance plan</p>
            <p>For example: oil change every 10,000 km or 6 months, whichever comes first.</p>
        </field>
    </record>
</odoo>
